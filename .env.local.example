# HitPay · Build with AI — Manila · Showcase
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in the Supabase dashboard → Project Settings → API.
#
#   NEXT_PUBLIC_SUPABASE_URL      = Project URL      (https://xxxx.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = Project API keys → anon / public key
#
# Both are safe to expose to the browser (they are public by design and the
# database is protected by Row Level Security — see supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# /admin — lets you delete showcase posts. Both of these are server-only
# secrets: never prefix them with NEXT_PUBLIC_, never commit real values.
#
#   ADMIN_PASSWORD           = any password you choose for the /admin page
#   SUPABASE_SERVICE_ROLE_KEY = Project API keys → service_role key (secret)
#     (lets /admin delete any post, bypassing Row Level Security)

ADMIN_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
